# Docker Compose Environment Variables

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_DB=virtualuni
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password
REDIS_PORT=6379

# Application Ports
BACKEND_PORT=3001
FRONTEND_PORT=80

# Note: For production deployment, create a .env file based on this template
# and update all passwords and secrets with strong, unique values.
