# Database
DATABASE_URL="postgresql://postgres:your-secure-password@postgres:5432/virtualuni?schema=public"

# JWT
JWT_SECRET="your-production-jwt-secret-key-minimum-32-characters-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-production-refresh-secret-key-minimum-32-characters-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Application
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Stripe (for billing and subscriptions)
STRIPE_SECRET_KEY=sk_live_your_live_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_BASIC_PRICE_ID=price_your_basic_plan_id
STRIPE_PRO_PRICE_ID=price_your_pro_plan_id
STRIPE_ENTERPRISE_PRICE_ID=price_your_enterprise_plan_id

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Cache (improves analytics performance significantly)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
