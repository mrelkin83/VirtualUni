# Database
DATABASE_URL="postgresql://postgres:your-secure-password@postgres:5432/virtualuni?schema=public"

# JWT
JWT_SECRET="your-production-jwt-secret-key-minimum-32-characters-long"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-production-refresh-secret-key-minimum-32-characters-long"
JWT_REFRESH_EXPIRES_IN="7d"

# Application
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-domain.com

# Wompi (for billing and subscriptions) — production keys, prefix pub_prod_/prv_prod_/prod_events_/prod_integrity_
WOMPI_PUBLIC_KEY=pub_prod_your_wompi_public_key
WOMPI_PRIVATE_KEY=prv_prod_your_wompi_private_key
WOMPI_EVENTS_SECRET=prod_events_your_wompi_events_secret
WOMPI_INTEGRITY_SECRET=prod_integrity_your_wompi_integrity_secret

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Cache (improves analytics performance significantly)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# Security
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
