{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "tsconfig.json",
    "assets": [
      { "include": "modules/public-site/templates/**/*", "watchAssets": true },
      { "include": "modules/public-site/assets/**/*", "watchAssets": true }
    ]
  }
}
