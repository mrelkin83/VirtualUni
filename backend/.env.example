# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/virtualuni?schema=public"

# JWT
# Genera uno propio: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# El arranque en produccion falla si conserva el valor de ejemplo o mide menos de 32 caracteres.
JWT_SECRET=cambia-este-valor-por-uno-generado-aleatoriamente
JWT_EXPIRES_IN="15m"
# Debe ser DISTINTO de JWT_SECRET.
JWT_REFRESH_SECRET=cambia-este-valor-por-otro-generado-aleatoriamente
JWT_REFRESH_EXPIRES_IN="7d"

# Application
# El frontend (src/config/api.config.ts y vite.config.ts) espera el backend en el puerto 4000
PORT=4000
NODE_ENV=development
# Vite dev server corre en el puerto 3000 (vite.config.ts)
FRONTEND_URL=http://localhost:3000

# Wompi (para facturación y suscripciones) — panel: comercios.wompi.co
# Llaves de sandbox mientras se prueba; para producción llevan el prefijo
# pub_prod_/prv_prod_/prod_events_/prod_integrity_ en vez de _test_.
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_EVENTS_SECRET=test_events_...
WOMPI_INTEGRITY_SECRET=test_integrity_...

# Email (opcional - para notificaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Redis Cache (opcional - mejora el rendimiento de analytics)
# El sistema funciona sin Redis, pero el caché mejora significativamente el performance
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Almacenamiento de archivos subidos (por defecto: <backend>/uploads)
# UPLOADS_DIR=
