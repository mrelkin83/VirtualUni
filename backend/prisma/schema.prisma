// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SHARED SCHEMA (public) - System Level
// ============================================

model Tenant {
  id           String       @id @default(uuid())
  slug         String       @unique
  name         String
  subdomain    String       @unique
  customDomain String?      @unique @map("custom_domain")
  plan         Plan         @default(FREE)
  status       TenantStatus @default(TRIAL)

  // Settings
  logo           String?
  primaryColor   String  @default("#3B82F6") @map("primary_color")
  secondaryColor String  @default("#8B5CF6") @map("secondary_color")

  // Features
  enableMessaging    Boolean @default(true) @map("enable_messaging")
  // Integraciones del sitio público (§13.7): qué plan incluye cuál es
  // decisión comercial pendiente; por ahora son banderas por tenant.
  enableEmbed        Boolean @default(false) @map("enable_embed")
  enablePublicApi    Boolean @default(false) @map("enable_public_api")
  enableVideoConf    Boolean @default(false) @map("enable_video_conf")
  enablePayments     Boolean @default(false) @map("enable_payments")
  enableCertificates Boolean @default(false) @map("enable_certificates")

  // Limits
  maxStudents Int @default(20) @map("max_students")
  maxTeachers Int @default(2) @map("max_teachers")
  maxCourses  Int @default(5) @map("max_courses")
  storageGB   Int @default(1) @map("storage_gb")

  // Current Usage
  currentStudents  Int   @default(0) @map("current_students")
  currentTeachers  Int   @default(0) @map("current_teachers")
  currentCourses   Int   @default(0) @map("current_courses")
  currentStorageGB Float @default(0) @map("current_storage_gb")

  // Metadata
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  trialEndsAt DateTime? @map("trial_ends_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  subscriptions Subscription[]
  invoices      Invoice[]
  users         User[]

  @@map("tenants")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  // Antes stripeSubscriptionId: Wompi no tiene un objeto "suscripción", así
  // que esto guarda la `reference` del checkout que activó/renovó el plan.
  externalReference  String?            @unique @map("external_reference")
  plan               Plan
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model Invoice {
  id                 String        @id @default(uuid())
  tenantId           String        @map("tenant_id")
  // Antes stripeInvoiceId: el id de la transacción aprobada en Wompi.
  wompiTransactionId String?       @unique @map("wompi_transaction_id")
  amountCents        Int           @map("amount_cents")
  currency           String        @default("COP")
  status             InvoiceStatus
  pdfUrl             String?       @map("pdf_url")
  createdAt          DateTime      @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("invoices")
}

// ============================================
// TENANT SCHEMA - User Level
// ============================================

model User {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  email             String
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  role              UserRole
  avatarUrl         String?   @map("avatar_url")
  isActive          Boolean   @default(true) @map("is_active")
  lastLoginAt       DateTime? @map("last_login_at")
  // Momento del ultimo cierre de sesion. Los refresh tokens emitidos antes de
  // esta marca dejan de valer: sin ella, cerrar sesion no invalidaba nada.
  sessionsRevokedAt DateTime? @map("sessions_revoked_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student Student?
  teacher Teacher?

  forumTopics       ForumTopic[]
  forumReplies      ForumReply[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  communityLikes    CommunityLike[]

  @@unique([tenantId, email])
  @@map("users")
}

model Student {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  tenantId       String    @map("tenant_id")
  studentCode    String    @map("student_code")
  // program y semester son LEGADO de solo lectura: la inscripción real vive
  // en ProgramEnrollment. Se conservan hasta aprobar su eliminación.
  program        String?
  semester       String?
  enrollmentDate DateTime? @map("enrollment_date")
  status         String    @default("active")

  // Personal Info (from original PerfilSection)
  tipoIdentificacion   String?   @map("tipo_identificacion")
  numeroIdentificacion String?   @map("numero_identificacion")
  sexo                 String?
  telefono             String?
  celular              String?
  fechaNacimiento      DateTime? @map("fecha_nacimiento")
  lugarNacimiento      String?   @map("lugar_nacimiento")
  direccion            String?
  lugarResidencia      String?   @map("lugar_residencia")
  barrio               String?
  zona                 String?
  estrato              String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  submissions         Submission[]
  grades              Grade[]
  examAttempts        ExamAttempt[]
  attendances         Attendance[]
  groupMembers        GroupMember[]
  bookLoans           BookLoan[]
  bookReservations    BookReservation[]
  certificateRequests CertificateRequest[]
  invoices            StudentInvoice[]
  programEnrollments  ProgramEnrollment[]
  subjectRecords      StudentSubjectRecord[]
  homologationRequests HomologationRequest[]

  @@unique([tenantId, studentCode])
  @@map("students")
}

model Teacher {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  tenantId       String    @map("tenant_id")
  employeeCode   String    @map("employee_code")
  department     String?
  specialization String?
  hireDate       DateTime? @map("hire_date")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courses        Course[]
  grades         Grade[]
  subjectEditors SubjectEditor[]

  @@unique([tenantId, employeeCode])
  @@map("teachers")
}

// Course = GRUPO: una Subject dictada en un Periodo por un Docente. El nombre
// del modelo no se cambia porque lo usan ~40 módulos; en la UI se etiqueta
// "Grupo". subjectId/academicPeriodId son nullable en esta entrega para no
// romper los datos y flujos existentes.
model Course {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  teacherId   String  @map("teacher_id")
  // code, name, credits y semester son LEGADO: con subjectId presente, el
  // código/nombre/créditos canónicos viven en la Subject y el periodo en
  // AcademicPeriod. Se conservan hasta aprobar su eliminación.
  code        String
  name        String
  description String?
  credits     Int?
  semester    String?
  color       String  @default("bg-blue-500")
  status      String  @default("active")

  subjectId        String?   @map("subject_id")
  academicPeriodId String?   @map("academic_period_id")
  groupCode        String?   @map("group_code") // "A", "01"
  capacity         Int?
  modality         Modality?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  teacher        Teacher         @relation(fields: [teacherId], references: [id])
  subject        Subject?        @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  enrollments    Enrollment[]
  assignments    Assignment[]
  topics         CourseTopic[]
  grades         Grade[]
  exams          Exam[]
  attendances    Attendance[]

  materials       Material[]
  materialFolders MaterialFolder[]
  liveClasses     LiveClass[]
  groups          CourseGroup[]
  scheduleEvents  ScheduleEvent[]
  subjectRecords  StudentSubjectRecord[]

  // Cierre de notas: con gradesClosedAt presente las notas del grupo quedan
  // bloqueadas; solo un admin puede reabrir (queda auditado en los records).
  gradesClosedAt   DateTime? @map("grades_closed_at")
  gradesClosedById String?   @map("grades_closed_by_id") // userId de quien cerró

  @@unique([tenantId, code])
  @@index([teacherId])
  @@index([subjectId])
  @@index([academicPeriodId])
  @@map("courses")
}

// Un tema pertenece O a un grupo (courseId: contenido propio) O a una
// asignatura (subjectId: contenido maestro que heredan todos sus grupos).
// La exclusividad se valida en el servicio.
model CourseTopic {
  id          String   @id @default(uuid())
  courseId    String?  @map("course_id")
  subjectId   String?  @map("subject_id")
  tenantId    String   @map("tenant_id")
  title       String
  description String?
  orderIndex  Int      @map("order_index")
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  course  Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subject Subject?     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  blocks  TopicBlock[]

  @@index([courseId])
  @@index([subjectId])
  @@map("course_topics")
}

model TopicBlock {
  id         String   @id @default(uuid())
  topicId    String   @map("topic_id")
  tenantId   String   @map("tenant_id")
  title      String
  content    String?  @db.Text
  objectives String[]
  keyIdeas   String[] @map("key_ideas")
  orderIndex Int      @map("order_index")

  // Relations
  topic CourseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@map("topic_blocks")
}

model Enrollment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  studentId  String   @map("student_id")
  courseId   String   @map("course_id")
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  status     String   @default("active")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Assignment {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  courseId    String   @map("course_id")
  title       String
  description String?  @db.Text
  dueDate     DateTime @map("due_date")
  totalPoints Int      @default(100) @map("total_points")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([courseId])
  @@map("assignments")
}

model Submission {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  assignmentId String    @map("assignment_id")
  studentId    String    @map("student_id")
  fileUrl      String?   @map("file_url")
  content      String?   @db.Text
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  grade        Float?
  feedback     String?   @db.Text
  gradedAt     DateTime? @map("graded_at")

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@map("submissions")
}

model Grade {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  studentId String   @map("student_id")
  courseId  String   @map("course_id")
  teacherId String   @map("teacher_id")
  gradeType String   @map("grade_type") // 'parcial1', 'parcial2', 'talleres', 'proyecto'
  grade     Float
  weight    Float?
  gradedAt  DateTime @default(now()) @map("graded_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@index([studentId])
  @@index([courseId])
  @@index([teacherId])
  @@map("grades")
}

model Message {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  subject     String
  body        String    @db.Text
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // findInbox/findSent (messages.service.ts) filtran exactamente por estas
  // dos combinaciones; sin índice, cada bandeja de entrada hacía un Seq Scan
  // completo de la tabla.
  @@index([recipientId, tenantId])
  @@index([senderId, tenantId])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  tenantId  String           @map("tenant_id")
  userId    String           @map("user_id")
  titulo    String
  mensaje   String           @db.Text
  tipo      NotificationType
  icono     String?
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@index([userId, leida])
  @@index([tenantId])
  @@map("notifications")
}

// ============================================
// EXAMS & ATTENDANCE
// ============================================

model Exam {
  id                 String     @id @default(uuid())
  tenantId           String     @map("tenant_id")
  courseId           String     @map("course_id")
  titulo             String
  instrucciones      String?    @db.Text
  fecha              DateTime
  duracion           Int // minutos
  estado             ExamStatus @default(PROGRAMADO)
  puntajeTotal       Float      @default(0) @map("puntaje_total")
  notaMinima         Float      @default(60) @map("nota_minima") // escala 0-100
  intentosPermitidos Int        @default(1) @map("intentos_permitidos")
  mostrarResultados  Boolean    @default(true) @map("mostrar_resultados")
  mezclarPreguntas   Boolean    @default(false) @map("mezclar_preguntas")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  // Relations
  course    Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  preguntas ExamQuestion[]
  intentos  ExamAttempt[]

  @@index([tenantId])
  @@index([courseId])
  @@index([estado])
  @@map("exams")
}

model ExamQuestion {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  examId            String   @map("exam_id")
  pregunta          String   @db.Text
  opciones          String[]
  respuestaCorrecta Int      @map("respuesta_correcta") // índice en opciones
  puntaje           Float    @default(1)
  orderIndex        Int      @default(0) @map("order_index")

  // Relations
  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("exam_questions")
}

model ExamAttempt {
  id           String        @id @default(uuid())
  tenantId     String        @map("tenant_id")
  examId       String        @map("exam_id")
  studentId    String        @map("student_id")
  estado       AttemptStatus @default(EN_CURSO)
  respuestas   Json          @default("{}") // { [questionId]: indiceSeleccionado }
  calificacion Float?
  correctas    Int?
  iniciadoAt   DateTime      @default(now()) @map("iniciado_at")
  enviadoAt    DateTime?     @map("enviado_at")

  // Relations
  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([examId])
  @@index([studentId])
  @@map("exam_attempts")
}

model Attendance {
  id            String           @id @default(uuid())
  tenantId      String           @map("tenant_id")
  courseId      String           @map("course_id")
  studentId     String           @map("student_id")
  fecha         DateTime         @db.Date
  estado        AttendanceStatus
  observacion   String?
  registradoPor String           @map("registrado_por") // userId del docente
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId, fecha])
  @@index([tenantId])
  @@index([courseId, fecha])
  @@index([studentId])
  @@map("attendances")
}

enum ExamStatus {
  PROGRAMADO
  ACTIVO
  FINALIZADO
}

enum AttemptStatus {
  EN_CURSO
  ENVIADO
  CALIFICADO
}

enum AttendanceStatus {
  PRESENTE
  AUSENTE
  TARDE
  JUSTIFICADO
}

// ============================================
// ENUMS
// ============================================

enum Plan {
  FREE
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  TEACHER
  STUDENT
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ============================================
// ADMIN MODULES - Assets, Inventory, Payroll, HR, ID Cards
// ============================================

// Gestión de Activos
model Asset {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  codigo      String
  nombre      String
  categoria   AssetCategory
  descripcion String        @db.Text
  valorCompra Float         @map("valor_compra")
  valorActual Float         @map("valor_actual")
  fechaCompra DateTime      @map("fecha_compra")
  estado      AssetStatus
  ubicacion   String
  responsable String
  imagenUrl   String?       @map("imagen_url")
  numeroSerie String?       @map("numero_serie")
  proveedor   String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([categoria])
  @@index([estado])
  @@map("assets")
}

// Inventario
model InventoryItem {
  id                String          @id @default(uuid())
  tenantId          String          @map("tenant_id")
  codigo            String
  nombre            String
  categoria         String
  cantidad          Int
  cantidadMinima    Int             @map("cantidad_minima")
  unidadMedida      String          @map("unidad_medida")
  precioUnitario    Float           @map("precio_unitario")
  ubicacion         String
  proveedor         String
  fechaUltimaCompra DateTime        @map("fecha_ultima_compra")
  estado            InventoryStatus
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  movements InventoryMovement[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@index([categoria])
  @@index([estado])
  @@map("inventory_items")
}

model InventoryMovement {
  id          String       @id @default(uuid())
  tenantId    String       @map("tenant_id")
  itemId      String       @map("item_id")
  tipo        MovementType
  cantidad    Int
  motivo      String
  responsable String
  fecha       DateTime     @default(now())
  createdAt   DateTime     @default(now()) @map("created_at")

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([itemId])
  @@map("inventory_movements")
}

// Nómina
model PayrollEmployee {
  id             String         @id @default(uuid())
  tenantId       String         @map("tenant_id")
  nombre         String
  identificacion String
  cargo          String
  departamento   String
  salarioBase    Float          @map("salario_base")
  cuentaBancaria String         @map("cuenta_bancaria")
  banco          String
  estado         EmployeeStatus
  fechaIngreso   DateTime       @map("fecha_ingreso")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  payrollRecords PayrollRecord[]

  @@unique([tenantId, identificacion])
  @@index([tenantId])
  @@index([estado])
  @@map("payroll_employees")
}

model PayrollRecord {
  id             String        @id @default(uuid())
  tenantId       String        @map("tenant_id")
  empleadoId     String        @map("empleado_id")
  periodo        String
  fechaInicio    DateTime      @map("fecha_inicio")
  fechaFin       DateTime      @map("fecha_fin")
  fechaPago      DateTime      @map("fecha_pago")
  salarioBase    Float         @map("salario_base")
  bonificaciones Float         @default(0)
  deducciones    Float         @default(0)
  salarioNeto    Float         @map("salario_neto")
  estado         PayrollStatus
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  empleado PayrollEmployee @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([empleadoId])
  @@index([periodo])
  @@map("payroll_records")
}

// Recursos Humanos
model Employee {
  id                         String         @id @default(uuid())
  tenantId                   String         @map("tenant_id")
  nombre                     String
  identificacion             String
  email                      String
  telefono                   String
  cargo                      String
  departamento               String
  fechaIngreso               DateTime       @map("fecha_ingreso")
  tipoContrato               ContractType   @map("tipo_contrato")
  salario                    Float
  estado                     EmployeeStatus
  direccion                  String
  fechaNacimiento            DateTime       @map("fecha_nacimiento")
  genero                     Gender
  estadoCivil                CivilStatus    @map("estado_civil")
  contactoEmergenciaNombre   String         @map("contacto_emergencia_nombre")
  contactoEmergenciaTelefono String         @map("contacto_emergencia_telefono")
  contactoEmergenciaRelacion String         @map("contacto_emergencia_relacion")
  createdAt                  DateTime       @default(now()) @map("created_at")
  updatedAt                  DateTime       @updatedAt @map("updated_at")

  vacationRequests VacationRequest[]

  @@unique([tenantId, identificacion])
  @@index([tenantId])
  @@index([departamento])
  @@index([estado])
  @@map("employees")
}

model VacationRequest {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  empleadoId      String         @map("empleado_id")
  fechaInicio     DateTime       @map("fecha_inicio")
  fechaFin        DateTime       @map("fecha_fin")
  diasSolicitados Int            @map("dias_solicitados")
  motivo          String         @db.Text
  estado          VacationStatus
  fechaSolicitud  DateTime       @default(now()) @map("fecha_solicitud")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  empleado Employee @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([empleadoId])
  @@index([estado])
  @@map("vacation_requests")
}

// Carnetización
model IDCard {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  usuarioId        String       @map("usuario_id")
  nombre           String
  identificacion   String
  tipoUsuario      UserCardType @map("tipo_usuario")
  numeroCarnet     String       @map("numero_carnet")
  fechaEmision     DateTime     @map("fecha_emision")
  fechaVencimiento DateTime     @map("fecha_vencimiento")
  estado           CardStatus
  fotoUrl          String       @map("foto_url")
  qrCode           String?      @map("qr_code")

  // Relación con plantilla y expedición
  templateId String? @map("template_id")
  issuanceId String? @map("issuance_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  template CardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  issuance CardIssuance? @relation(fields: [issuanceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, numeroCarnet])
  @@index([tenantId])
  @@index([usuarioId])
  @@index([estado])
  @@index([templateId])
  @@index([issuanceId])
  @@map("id_cards")
}

// Plantillas de carnets
/// Plantillas del compositor de certificados del panel de administracion.
/// La seccion existia con un compositor visual completo --texto, campos
/// dinamicos, firma, codigo QR, tamano y margenes-- pero no habia modelo
/// alguno: todo vivia en memoria y se perdia al recargar.
/// Banco de preguntas reutilizables del profesorado.
/// El panel tenia el editor completo --tipos, opciones, puntaje, categoria--
/// pero las preguntas solo existen en la base atadas a un examen concreto
/// (ExamQuestion). Sin este modelo, el banco se perdia al recargar.
model QuestionBank {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  teacherId         String?  @map("teacher_id")
  // Pregunta maestra de una asignatura: la comparten todos sus grupos
  subjectId         String?  @map("subject_id")
  tipo              String   @default("multiple")
  pregunta          String   @db.Text
  opciones          String[]
  respuestaCorrecta Int?     @map("respuesta_correcta")
  puntos            Float    @default(1)
  categoria         String   @default("General")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([subjectId])
  @@map("question_bank")
}

/// Plantillas de mensaje del profesorado y la administracion.
model MessageTemplate {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  autorId   String?  @map("autor_id")
  nombre    String
  categoria String   @default("general")
  contenido String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("message_templates")
}

model CertificateTemplate {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  nombre        String
  descripcion   String?  @db.Text
  estado        String   @default("borrador") // borrador | publicado
  componentes   Json     @default("[]")
  configuracion Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  studyPlanBlocks StudyPlanBlock[]

  @@index([tenantId])
  @@map("certificate_templates")
}

model CardTemplate {
  id          String  @id @default(uuid())
  tenantId    String  @map("tenant_id")
  nombre      String
  descripcion String? @db.Text

  // Tipos de usuario que pueden usar esta plantilla
  tiposUsuario String[] @map("tipos_usuario") // Array de UserCardType como strings

  // Diseño de la plantilla (JSON)
  layoutConfig Json @map("layout_config") // Configuración del layout: posición de elementos
  campos       Json // Campos dinámicos y su configuración

  // Dimensiones en milímetros (tamaño tarjeta estándar CR80)
  ancho       Float  @default(85.6) // mm
  alto        Float  @default(53.98) // mm
  orientacion String @default("horizontal") // horizontal o vertical

  // Estilo y diseño
  colorPrimario    String @default("#3B82F6") @map("color_primario")
  colorSecundario  String @default("#1E40AF") @map("color_secundario")
  colorTexto       String @default("#FFFFFF") @map("color_texto")
  fuentePrincipal  String @default("Arial") @map("fuente_principal")
  fuenteSecundaria String @default("Arial") @map("fuente_secundaria")

  // Recursos visuales
  logoUrl           String? @map("logo_url")
  fondoFrontalUrl   String? @map("fondo_frontal_url")
  fondoPosteriorUrl String? @map("fondo_posterior_url")

  // Estado y configuración
  esActiva            Boolean @default(true) @map("es_activa")
  esPredeterminada    Boolean @default(false) @map("es_predeterminada")
  incluirQR           Boolean @default(true) @map("incluir_qr")
  incluirCodigoBarras Boolean @default(false) @map("incluir_codigo_barras")
  doblesCara          Boolean @default(true) @map("dobles_cara")

  // Metadata
  version   Int      @default(1)
  creadoPor String?  @map("creado_por")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  carnets      IDCard[]
  expediciones CardIssuance[]

  @@index([tenantId])
  @@index([esActiva])
  @@index([esPredeterminada])
  @@map("card_templates")
}

// Registro de expediciones de carnets
model CardIssuance {
  id         String  @id @default(uuid())
  tenantId   String  @map("tenant_id")
  templateId String? @map("template_id")
  /// Código no adivinable para /validar/:codigo (§13.5).
  verificationCode String? @unique @map("verification_code")

  // Información de expedición
  lote            String // Número de lote (auto-generado)
  tipoExpedicion  IssuanceType @map("tipo_expedicion")
  cantidad        Int
  cantidadExitosa Int          @default(0) @map("cantidad_exitosa")
  cantidadFallida Int          @default(0) @map("cantidad_fallida")

  // Usuario que realizó la expedición
  expedidoPor       String @map("expedido_por") // userId
  expedidoPorNombre String @map("expedido_por_nombre")

  // Detalles
  motivo        String? @db.Text
  observaciones String? @db.Text

  // Estado de procesamiento
  estado IssuanceStatus @default(PROCESANDO)

  // Archivos generados
  pdfUrl        String? @map("pdf_url")
  archivoZipUrl String? @map("archivo_zip_url")

  // Metadata de carnets generados
  carnetsGenerados String[] @map("carnets_generados") // Array de IDs de carnets
  errores          Json? // Errores durante la generación
  // Índice ya existente en la BD desde la migración
  // 20260809220000_indices_en_claves_foraneas (creado por SQL manual); no
  // estaba declarado aquí y `prisma migrate dev` intentaba borrarlo por eso.

  fechaExpedicion DateTime  @default(now()) @map("fecha_expedicion")
  fechaCompletado DateTime? @map("fecha_completado")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relaciones
  template CardTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  carnets  IDCard[]

  @@index([tenantId])
  @@index([lote])
  @@index([estado])
  @@index([templateId])
  @@index([tipoExpedicion])
  @@index([fechaExpedicion])
  @@index([expedidoPor])
  @@map("card_issuances")
}

