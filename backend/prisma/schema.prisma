  fechaRespuesta DateTime?       @map("fecha_respuesta")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([estado])
  @@index([solicitanteId])
  @@map("procedures")
}

// Mensajes Masivos
model MassMessage {
  id          String        @id @default(uuid())
  tenantId    String        @map("tenant_id")
  asunto      String
  contenido   String        @db.Text
  remitente   String
  targetRoles String[]      @map("target_roles")
  targetUsers String[]      @map("target_users")
  adjuntos    String[]
  estado      MessageStatus
  programado  DateTime?
  enviadoAt   DateTime?     @map("enviado_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([estado])
  @@map("mass_messages")
}

