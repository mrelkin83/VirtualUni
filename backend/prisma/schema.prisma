model Book {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  titulo                String
  autor                 String
  isbn                  String?
  categoria             String
  editorial             String?
  anio                  Int?
  descripcion           String?  @db.Text
  portadaUrl            String?  @map("portada_url")
  ubicacion             String?
  ejemplaresTotal       Int      @default(1) @map("ejemplares_total")
  ejemplaresDisponibles Int      @default(1) @map("ejemplares_disponibles")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  loans        BookLoan[]
  reservations BookReservation[]

  @@index([tenantId])
  @@index([categoria])
  @@map("books")
}

model BookLoan {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  bookId           String     @map("book_id")
  studentId        String     @map("student_id")
  fechaPrestamo    DateTime   @default(now()) @map("fecha_prestamo")
  fechaVencimiento DateTime   @map("fecha_vencimiento")
  fechaDevolucion  DateTime?  @map("fecha_devolucion")
  estado           LoanStatus @default(ACTIVO)
  renovaciones     Int        @default(0)
  observaciones    String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([estado])
  @@index([bookId])
  @@map("book_loans")
}

model BookReservation {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  bookId          String            @map("book_id")
  studentId       String            @map("student_id")
  fechaReserva    DateTime          @default(now()) @map("fecha_reserva")
  fechaExpiracion DateTime          @map("fecha_expiracion")
  estado          ReservationStatus @default(PENDIENTE)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([bookId])
  @@map("book_reservations")
}

model ForumTopic {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  courseId  String?  @map("course_id")
  autorId   String   @map("autor_id")
  titulo    String
  contenido String   @db.Text
  categoria String   @default("general")
  fijado    Boolean  @default(false)
  cerrado   Boolean  @default(false)
  vistas    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  autor   User         @relation(fields: [autorId], references: [id], onDelete: Cascade)
  replies ForumReply[]

  @@index([tenantId])
  @@index([courseId])
  @@index([autorId])
  @@map("forum_topics")
}

model ForumReply {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  topicId    String   @map("topic_id")
  autorId    String   @map("autor_id")
  contenido  String   @db.Text
  esSolucion Boolean  @default(false) @map("es_solucion")
  likes      Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  topic ForumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  autor User       @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([topicId])
  @@index([autorId])
  @@map("forum_replies")
}

model CommunityPost {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  autorId   String   @map("autor_id")
  contenido String   @db.Text
  imagenUrl String?  @map("imagen_url")
  categoria String   @default("general")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  autor    User               @relation(fields: [autorId], references: [id], onDelete: Cascade)
  comments CommunityComment[]
  likes    CommunityLike[]

  @@index([tenantId])
  @@index([autorId])
  @@map("community_posts")
}

model CommunityComment {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  postId    String   @map("post_id")
  autorId   String   @map("autor_id")
  contenido String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  post  CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  autor User          @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([postId])
  @@index([autorId])
  @@map("community_comments")
}

model CommunityLike {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([tenantId])
  @@index([userId])
  @@map("community_likes")
}

model CertificateRequest {
  id            String            @id @default(uuid())
  tenantId      String            @map("tenant_id")
  studentId     String            @map("student_id")
  tipo          String
  motivo        String?           @db.Text
  estado        CertificateStatus @default(PENDIENTE)
  costo         Float             @default(0)
  fechaEmision  DateTime?         @map("fecha_emision")
  /// Código no adivinable para /validar/:codigo (§13.5); se genera al emitir.
  verificationCode String?        @unique @map("verification_code")
  archivoUrl    String?           @map("archivo_url")
  observaciones String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([studentId])
  @@index([estado])
  @@map("certificate_requests")
}

model ScheduleEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  courseId   String?  @map("course_id")
  titulo     String
  tipo       String   @default("clase")
  diaSemana  Int      @map("dia_semana")
  horaInicio String   @map("hora_inicio")
  horaFin    String   @map("hora_fin")
  aula       String?
  color      String   @default("bg-blue-500")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([courseId])
  @@map("schedule_events")
}

enum LoanStatus {
  ACTIVO
  DEVUELTO
  VENCIDO
}

enum ReservationStatus {
  PENDIENTE
  LISTA
  CANCELADA
  COMPLETADA
}

enum CertificateStatus {
  PENDIENTE
  EN_PROCESO
  EMITIDO
  RECHAZADO
}

// ============================================================
// Estructura académica: Programas, Pensum, Asignaturas, Periodos
// ============================================================

// Nivel de formación (catálogo para Colombia: Ley 30, ETDH, formal, continua)
enum EducationLevel {
  TECNICO_PROFESIONAL
  TECNOLOGICO
  PROFESIONAL_UNIVERSITARIO
  ESPECIALIZACION
  MAESTRIA
  DOCTORADO
  TECNICO_LABORAL
  CONOCIMIENTOS_ACADEMICOS
  PREESCOLAR
  BASICA_PRIMARIA
  BASICA_SECUNDARIA
  MEDIA_BACHILLERATO
  BACHILLERATO_POR_CICLOS
  DIPLOMADO
  CURSO_LIBRE
  TALLER
  SEMINARIO
  OTRO
}

// Cómo avanza el programa en el tiempo
enum PeriodStructure {
  SEMESTRAL
  CUATRIMESTRAL
  TRIMESTRAL
  ANUAL
  POR_CICLOS
  MODULAR
  UNICO
}

// Unidad de medida académica del programa
enum AcademicUnit {
  CREDITOS
  HORAS
  INTENSIDAD_HORARIA_SEMANAL
}

enum Modality {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
  DISTANCIA
}

// Tipo de la asignatura dentro del pensum
enum SubjectType {
  OBLIGATORIA
  ELECTIVA
  OPTATIVA
  PRACTICA
  TRABAJO_DE_GRADO
}

enum ProgramStatus {
  BORRADOR
  ACTIVO
  INACTIVO
}

enum StudyPlanStatus {
  BORRADOR
  VIGENTE
  CERRADO
}

enum PeriodStatus {
  PLANEADO
  EN_CURSO
  CERRADO
}

enum ProgramEnrollmentStatus {
  ACTIVO
  APLAZADO
  RETIRADO
  GRADUADO
  CANCELADO
}

model Program {
  id              String          @id @default(uuid())
  tenantId        String          @map("tenant_id")
  code            String
  name            String
  description     String?         @db.Text
  educationLevel  EducationLevel  @map("education_level")
  modality        Modality
  periodStructure PeriodStructure @map("period_structure")
  academicUnit    AcademicUnit    @map("academic_unit")
  durationPeriods Int?            @map("duration_periods") // nº de semestres/grados/ciclos/módulos
  totalCredits    Int?            @map("total_credits")
  totalHours      Int?            @map("total_hours")
  degreeTitle     String?         @map("degree_title") // "Tecnólogo en Gestión Empresarial"
  officialCode    String?         @map("official_code") // SNIES o registro ETDH (opcional)
  approvalAct     String?         @map("approval_act") // resolución/registro calificado (texto libre)
  status          ProgramStatus   @default(BORRADOR)

  // Política académica del programa (cierre de notas y homologación)
  passingGrade        Float @default(3.0) @map("passing_grade") // nota mínima aprobatoria en la escala del programa
  gradeScaleMax       Float @default(5.0) @map("grade_scale_max")
  hoursPerCredit      Int   @default(48) @map("hours_per_credit")
  // % máximo del pensum reconocible por homologación EXTERNA. No aplica al
  // reconocimiento interno por misma Subject aprobada en la institución.
  maxRecognitionPct   Int   @default(50) @map("max_recognition_pct")
  minRecognitionGrade Float @default(3.0) @map("min_recognition_grade")

  // ---- Publicación en el sitio web público (sitio web e inscripciones) ----
  slug                String? // único por tenant; exigido al publicar
  isPublished         Boolean   @default(false) @map("is_published")
  shortDescription    String?   @map("short_description") // ≤ 200, tarjeta de la oferta
  publicDescription   String?   @db.Text @map("public_description")
  graduateProfile     String?   @db.Text @map("graduate_profile")
  occupationalProfile String?   @db.Text @map("occupational_profile")
  imageUrl            String?   @map("image_url")
  isNewUntil          DateTime? @map("is_new_until") // la etiqueta "NUEVO" se apaga sola
  area                String? // área o facultad, para el directorio público
  schedule            String? // jornada visible ("Nocturna", "Fines de semana")
  tuitionDisplay      String?   @map("tuition_display") // texto libre: "Desde $X por periodo"
  faq                 Json? // [{q, a}]

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  studyPlans         StudyPlan[]
  programEnrollments ProgramEnrollment[]
  admissionCalls     AdmissionCall[]

  @@unique([tenantId, code])
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("programs")
}

// Pensum versionado: al cambiar el plan de estudios se crea una versión nueva
// y los estudiantes antiguos permanecen en la suya.
model StudyPlan {
  id        String          @id @default(uuid())
  tenantId  String          @map("tenant_id")
  programId String          @map("program_id")
  version   String // "2027-1", "v2"
  status    StudyPlanStatus @default(BORRADOR)
  validFrom DateTime?       @map("valid_from")
  notes     String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  program            Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  subjects           StudyPlanSubject[]
  programEnrollments ProgramEnrollment[]
  blocks             StudyPlanBlock[]
  admissionCalls     AdmissionCall[]

  @@unique([programId, version])
  @@index([tenantId])
  @@map("study_plans")
}

// Asignatura/materia/módulo: catálogo transversal del tenant, no de un
// programa. Su contenido maestro se comparte entre todos los grupos que la
// dictan (temario/materiales/preguntas se enlazan en una fase posterior).
model Subject {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  description String?  @db.Text
  area        String? // área de conocimiento ("Matemáticas", "Ciencias Naturales")
  credits     Int?
  hours       Int? // horas totales
  weeklyHours Int?     @map("weekly_hours")
  // Desglose de horas (ETDH): si faltan, horas = créditos × hoursPerCredit
  theoreticalHours Int? @map("theoretical_hours")
  practicalHours   Int? @map("practical_hours")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  planEntries StudyPlanSubject[]
  courses     Course[] // grupos que la dictan
  records          StudentSubjectRecord[]
  equivalencesFrom SubjectEquivalence[] @relation("equivSource")
  equivalencesTo   SubjectEquivalence[] @relation("equivTarget")
  homologationItems HomologationItem[]

  // Contenido maestro compartido por todos los grupos de la asignatura
  topics          CourseTopic[]
  materialFolders MaterialFolder[]
  materials       Material[]
  questions       QuestionBank[]
  editors         SubjectEditor[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("subjects")
}

// Docentes habilitados por el admin para editar el contenido maestro de una
// asignatura. Por defecto el profesorado solo lo lee desde sus grupos.
model SubjectEditor {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  subjectId String   @map("subject_id")
  teacherId String   @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@index([tenantId])
  @@index([teacherId])
  @@map("subject_editors")
}

// Fila del pensum: una asignatura en un nivel de un plan de estudios
model StudyPlanSubject {
  id          String      @id @default(uuid())
  tenantId    String      @map("tenant_id")
  studyPlanId String      @map("study_plan_id")
  subjectId   String      @map("subject_id")
  level       Int // semestre / grado / ciclo / módulo (1..n); 1 para UNICO
  subjectType SubjectType @default(OBLIGATORIA) @map("subject_type")
  credits     Int? // override opcional del valor de la Subject
  hours       Int?
  // Overrides opcionales del desglose de horas de la Subject (ETDH)
  theoreticalHours Int? @map("theoretical_hours")
  practicalHours   Int? @map("practical_hours")
  orderIndex  Int         @default(0) @map("order_index")
  // Bloque de competencia certificable al que pertenece la fila (opcional)
  blockId     String?     @map("block_id")

  studyPlan     StudyPlan               @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  subject       Subject                 @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  block         StudyPlanBlock?         @relation(fields: [blockId], references: [id], onDelete: SetNull)
  prerequisites StudyPlanPrerequisite[] @relation("entry")
  requiredBy    StudyPlanPrerequisite[] @relation("required")

  @@unique([studyPlanId, subjectId])
  @@index([tenantId])
  @@index([subjectId])
  @@index([blockId])
  @@map("study_plan_subjects")
}

model StudyPlanPrerequisite {
  id         String @id @default(uuid())
  tenantId   String @map("tenant_id")
  entryId    String @map("entry_id") // la asignatura que tiene el requisito
  requiredId String @map("required_id") // la que hay que aprobar antes (misma StudyPlan)

  entry    StudyPlanSubject @relation("entry", fields: [entryId], references: [id], onDelete: Cascade)
  required StudyPlanSubject @relation("required", fields: [requiredId], references: [id], onDelete: Cascade)

  @@unique([entryId, requiredId])
  @@index([requiredId])
  @@map("study_plan_prerequisites")
}

model AcademicPeriod {
  id        String       @id @default(uuid())
  tenantId  String       @map("tenant_id")
  code      String // "2027-1", "2027", "COHORTE-03"
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    PeriodStatus @default(PLANEADO)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  courses Course[]
  subjectRecords StudentSubjectRecord[]
  admissionCalls AdmissionCall[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("academic_periods")
}

// Inscripción del estudiante a un programa, con su versión de pensum
model ProgramEnrollment {
  id           String                  @id @default(uuid())
  tenantId     String                  @map("tenant_id")
  studentId    String                  @map("student_id")
  programId    String                  @map("program_id")
  studyPlanId  String                  @map("study_plan_id")
  currentLevel Int                     @default(1) @map("current_level")
  status       ProgramEnrollmentStatus @default(ACTIVO)
  startDate    DateTime                @default(now()) @map("start_date")
  endDate      DateTime?               @map("end_date")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program   Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Restrict)
  homologationRequests HomologationRequest[]

  @@unique([studentId, programId]) // varios programas sí; dos veces el mismo, no
  @@index([tenantId])
  @@index([programId])
  @@map("program_enrollments")
}

// ============================================================
// Historial académico, homologación y bloques certificables
// ============================================================

// Cómo quedó aprobada (o reprobada) la asignatura en el historial
enum RecordOrigin {
  CURSADA // cursó el grupo y se cerraron notas
  RECONOCIMIENTO_INTERNO // misma Subject aprobada antes en la institución
  HOMOLOGACION_EQUIVALENCIA // otra Subject equivalente (SubjectEquivalence)
  RECONOCIMIENTO_EXTERNO // cursada en otra institución, con soporte
  VALIDACION_SUFICIENCIA // examen de suficiencia
}

enum RecordStatus {
  VIGENTE
  ANULADO // p. ej. al reabrir notas de un grupo
}

enum HomologationType {
  EQUIVALENCIA_INTERNA
  EXTERNA
  VALIDACION_SUFICIENCIA
}

enum HomologationStatus {
  SOLICITADA
  EN_REVISION
  APROBADA
  APROBADA_PARCIAL
  RECHAZADA
}

// Historial académico: una fila por intento definitivo del estudiante en una
// asignatura. El historial es del ESTUDIANTE, no del programa: una asignatura
// aprobada sirve para cualquier programa presente o futuro.
model StudentSubjectRecord {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  studentId        String       @map("student_id")
  subjectId        String       @map("subject_id")
  courseId         String?      @map("course_id") // grupo donde la cursó (null si es homologación)
  academicPeriodId String?      @map("academic_period_id")
  origin           RecordOrigin
  finalGrade       Float?       @map("final_grade") // en la escala del programa; null para reconocimientos sin nota
  passed           Boolean
  creditsSnapshot  Int?         @map("credits_snapshot")
  hoursSnapshot    Int?         @map("hours_snapshot")
  status           RecordStatus @default(VIGENTE)
  approvedById     String?      @map("approved_by_id") // userId del admin/docente que cerró o aprobó
  approvedAt       DateTime?    @map("approved_at")
  sourceRecordId   String?      @map("source_record_id") // registro original (RECONOCIMIENTO_INTERNO)
  sourceRequestId  String?      @map("source_request_id") // HomologationRequest que lo originó
  notes            String?      @db.Text
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  course         Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  academicPeriod AcademicPeriod? @relation(fields: [academicPeriodId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([studentId, subjectId])
  @@index([courseId])
  @@map("student_subject_records")
}

// "Aprobar X equivale a aprobar Y" cuando NO son la misma Subject.
// La homologación entre programas de la institución que comparten la misma
// Subject NO pasa por aquí: es reconocimiento interno automático.
model SubjectEquivalence {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  sourceSubjectId String  @map("source_subject_id")
  targetSubjectId String  @map("target_subject_id")
  bidirectional   Boolean @default(false)
  notes           String?

  sourceSubject Subject @relation("equivSource", fields: [sourceSubjectId], references: [id], onDelete: Cascade)
  targetSubject Subject @relation("equivTarget", fields: [targetSubjectId], references: [id], onDelete: Cascade)

  @@unique([sourceSubjectId, targetSubjectId])
  @@index([tenantId])
  @@index([targetSubjectId])
  @@map("subject_equivalences")
}

// Solicitud de homologación con soportes y aprobación ítem por ítem
model HomologationRequest {
  id                  String             @id @default(uuid())
  tenantId            String             @map("tenant_id")
  studentId           String             @map("student_id")
  programEnrollmentId String             @map("program_enrollment_id") // programa destino
  type                HomologationType
  status              HomologationStatus @default(SOLICITADA)
  originInstitution   String?            @map("origin_institution")
  supportFiles        String[]           @map("support_files") // URLs del módulo de uploads
  reviewedById        String?            @map("reviewed_by_id") // userId del revisor
  reviewedAt          DateTime?          @map("reviewed_at")
  decisionNotes       String?            @db.Text @map("decision_notes")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  student           Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  programEnrollment ProgramEnrollment  @relation(fields: [programEnrollmentId], references: [id], onDelete: Cascade)
  items             HomologationItem[]

  @@index([tenantId])
  @@index([studentId])
  @@map("homologation_requests")
}

model HomologationItem {
  id              String  @id @default(uuid())
  tenantId        String  @map("tenant_id")
  requestId       String  @map("request_id")
  targetSubjectId String  @map("target_subject_id") // asignatura del pensum destino
  originName      String? @map("origin_name") // nombre en la institución de origen
  originHours     Int?    @map("origin_hours")
  originGrade     Float?  @map("origin_grade")
  decision        String? // APROBADO | RECHAZADO
  decisionNotes   String? @db.Text @map("decision_notes") // justificación (obligatoria al forzar validaciones)

  request       HomologationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  targetSubject Subject             @relation(fields: [targetSubjectId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([requestId])
  @@map("homologation_items")
}

// Bloque de competencia certificable dentro de un pensum
model StudyPlanBlock {
  id                     String  @id @default(uuid())
  tenantId               String  @map("tenant_id")
  studyPlanId            String  @map("study_plan_id")
  name                   String // "Módulo Contable-Financiero"
  description            String? @db.Text
  orderIndex             Int     @default(0) @map("order_index")
  certifiable            Boolean @default(true)
  certificateTemplateId  String? @map("certificate_template_id")
  competencyStandardCode String? @map("competency_standard_code") // norma de competencia laboral (opcional)

  studyPlan           StudyPlan            @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  certificateTemplate CertificateTemplate? @relation(fields: [certificateTemplateId], references: [id], onDelete: SetNull)
  subjects            StudyPlanSubject[]

  @@index([tenantId])
  @@index([studyPlanId])
  @@map("study_plan_blocks")
}

// ============================================================================
// Sitio web público por institución e inscripciones en línea
// ============================================================================

// Tipo de institución: SOLO pone valores por defecto (textos, filtros, campos
// del formulario). La lógica real se decide por el EducationLevel de cada
// programa, porque una institución MIXTA ofrece de todo.
enum InstitutionType {
  COLEGIO
  ETDH
  TECNICA_PROFESIONAL
  TECNOLOGICA
  UNIVERSITARIA
  UNIVERSIDAD
  MIXTA
}

enum SiteMode {
  FULL // sitio completo con portada
  ADMISSIONS_ONLY // solo /programas, /inscripcion, /aspirante y /validar (ya tienen web propia)
  OFF
}

enum AdmissionCallStatus {
  BORRADOR
  ABIERTA
  CERRADA
}

enum ApplicationStatus {
  INTERESADO // solo contacto (lead); todavía sin convocatoria o sin formulario
  BORRADOR
  ENVIADA
  PAGO_PENDIENTE
  PAGO_EN_VERIFICACION
  PAGADA
  EN_REVISION
  DOCUMENTOS_INCOMPLETOS
  ADMITIDA
  NO_ADMITIDA
  MATRICULADA
  DESISTIO
}

// Configuración del sitio público del tenant. Los campos Json se validan con
// DTOs anidados al guardar y se escapan al renderizar: nunca HTML libre.
model TenantSite {
  id                 String          @id @default(uuid())
  tenantId           String          @unique @map("tenant_id")
  institutionType    InstitutionType @default(MIXTA) @map("institution_type")
  published          Boolean         @default(false)
  siteMode           SiteMode        @default(FULL) @map("site_mode")
  externalWebsiteUrl String?         @map("external_website_url") // su web propia (modo ADMISSIONS_ONLY)
  heroSlides         Json            @map("hero_slides") // [{title, subtitle, imageUrl, overlay, ctaPrimary, ctaSecondary}] máx. 3
  showHeroSearch     Boolean         @default(true) @map("show_hero_search")
  sections           Json // orden y visibilidad: featured, calls, benefits, stats, cta
  benefits           Json? // [{icon, title, text}]
  stats              Json? // [{value, label}] las escribe la institución
  featuredProgramIds String[]        @map("featured_program_ids")
  levelLabels        Json?           @map("level_labels") // renombrar/ocultar categorías públicas
  contact            Json? // dirección, teléfonos, email, horario, mapa, redes
  whatsappNumber     String?         @map("whatsapp_number")
  whatsappMessage    String?         @map("whatsapp_message")
  seoTitle           String?         @map("seo_title")
  seoDescription     String?         @map("seo_description")
  analytics          Json? // {ga4, gtm, metaPixel, adsConversion}; sin id configurado no se carga nada
  /// Pago MANUAL de inscripción (§7): cuenta, Nequi, QR… lo escribe la institución.
  paymentInstructions String?        @db.Text @map("payment_instructions")
  privacyPolicy      String?         @db.Text @map("privacy_policy")
  privacyPolicyUrl   String?         @map("privacy_policy_url")
  privacyVersion     String          @default("1") @map("privacy_version")
  dataControllerName String?         @map("data_controller_name") // responsable del tratamiento
  /// Dominios autorizados a incrustar los widgets /embed/* (frame-ancestors).
  embedAllowedOrigins String[]       @default([]) @map("embed_allowed_origins")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  @@map("tenant_sites")
}

// ============================================================================
// Integraciones con webs propias (Fase 7, §13)
// ============================================================================

enum ApiKeyType {
  PUBLISHABLE // pk_: solo lectura pública, usable en navegador, limitada a allowedOrigins
  SECRET // sk_: servidor a servidor; con cabecera Origin se RECHAZA
}

// La llave completa se muestra UNA sola vez al crearla; aquí vive su hash.
model ApiKey {
  id             String     @id @default(uuid())
  tenantId       String     @map("tenant_id")
  name           String
  type           ApiKeyType
  prefix         String // visible: pk_live_ab12…, sk_test_…
  keyHash        String     @unique @map("key_hash") // sha256 de la llave completa
  testMode       Boolean    @default(false) @map("test_mode")
  scopes         String[]
  allowedOrigins String[]   @default([]) @map("allowed_origins") // solo publicables
  lastUsedAt     DateTime?  @map("last_used_at")
  revokedAt      DateTime?  @map("revoked_at")
  createdById    String?    @map("created_by_id")
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("api_keys")
}

// Idempotencia de los POST de la API pública: misma llave → misma respuesta, 24 h.
model ApiIdempotencyKey {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  key       String
  status    Int
  response  Json
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, key])
  @@index([createdAt])
  @@map("api_idempotency_keys")
}

model WebhookEndpoint {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  url          String // solo HTTPS (y http://localhost en dev)
  events       String[] // application.submitted, payment.confirmed…
  secretEnc    String    @map("secret_enc") // cifrado AES-256-GCM; se muestra al crear
  active       Boolean   @default(true)
  failureCount Int       @default(0) @map("failure_count")
  createdAt    DateTime  @default(now()) @map("created_at")

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  endpointId    String    @map("endpoint_id")
  eventType     String    @map("event_type")
  payload       Json
  attempt       Int       @default(0)
  responseCode  Int?      @map("response_code")
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at")
  deliveredAt   DateTime? @map("delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
  @@index([tenantId, createdAt])
  @@map("webhook_deliveries")
}

// Outbox de eventos de dominio (§9): cada hito de una solicitud queda aquí
// para que un motor externo (WhatsApp, webhooks salientes de la Fase 7) lo
// consuma sin acoplarse al flujo. deliveredAt lo marca el consumidor.
model OutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  type        String // application.submitted, payment.confirmed, application.admitted…
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  deliveredAt DateTime? @map("delivered_at")

  @@index([tenantId, createdAt])
  @@index([deliveredAt])
  @@map("outbox_events")
}

// Llaves de Wompi DE LA INSTITUCIÓN para cobrar su propia inscripción (§7).
// Las llaves sensibles van cifradas con AES-256-GCM (clave maestra en
// PAYMENTS_MASTER_KEY) y NUNCA vuelven al frontend: solo "configurada sí/no".
// Separado por completo del billing de suscripciones de la plataforma.
model TenantPaymentConfig {
  id              String   @id @default(uuid())
  tenantId        String   @unique @map("tenant_id")
  publicKey       String?  @map("public_key") // pub_test_/pub_prod_: no es secreta
  integrityKeyEnc String?  @map("integrity_key_enc")
  eventsKeyEnc    String?  @map("events_key_enc")
  testMode        Boolean  @default(true) @map("test_mode")
  active          Boolean  @default(false)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("tenant_payment_configs")
}

// Convocatoria de inscripción a un programa en un periodo, con su pensum.
model AdmissionCall {
  id               String              @id @default(uuid())
  tenantId         String              @map("tenant_id")
  programId        String              @map("program_id")
  academicPeriodId String              @map("academic_period_id")
  studyPlanId      String              @map("study_plan_id")
  name             String // "Inscripciones 2027-1 – Jornada nocturna"
  slug             String
  opensAt          DateTime            @map("opens_at")
  closesAt         DateTime?           @map("closes_at") // null solo si rolling
  capacity         Int?
  schedule         String? // jornada
  modality         Modality?
  applicationFee   Int                 @default(0) @map("application_fee") // COP, entero
  paymentMethods   String[]            @map("payment_methods") // ["MANUAL","WOMPI"]
  status           AdmissionCallStatus @default(BORRADOR)
  rolling          Boolean             @default(false) // inscripción permanente (ETDH, cursos)
  startsAt         DateTime?           @map("starts_at") // inicio de clases/cohorte, visible en la tarjeta
  targetLevels     Json?               @map("target_levels") // colegio: [{level, label, capacity}] cupos por grado
  minAge           Int?                @map("min_age")
  maxAge           Int?                @map("max_age")
  minEducation     String?             @map("min_education") // "9° aprobado", "Bachiller", "Profesional"
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  program           Program                     @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicPeriod    AcademicPeriod              @relation(fields: [academicPeriodId], references: [id], onDelete: Restrict)
  studyPlan         StudyPlan                   @relation(fields: [studyPlanId], references: [id], onDelete: Restrict)
  requiredDocuments AdmissionRequiredDocument[]
  applications      Application[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([programId])
  @@map("admission_calls")
}

model AdmissionRequiredDocument {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  callId      String   @map("call_id")
  name        String // "Documento de identidad", "Diploma de bachiller"
  required    Boolean  @default(true)
  acceptTypes String[] @map("accept_types") // ["application/pdf","image/jpeg","image/png"]
  maxSizeMb   Int      @default(5) @map("max_size_mb")

  call      AdmissionCall         @relation(fields: [callId], references: [id], onDelete: Cascade)
  documents ApplicationDocument[]

  @@index([callId])
  @@map("admission_required_documents")
}

// Aspirante: NO es Student. studentId se llena al admitir/matricular, o si el
// documento ya correspondía a un estudiante del tenant (patrón del repo:
// ids de usuario como texto plano validados en el servicio, sin FK).
model Applicant {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  documentType      String    @map("document_type")
  documentNumber    String    @map("document_number")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  email             String
  phone             String
  birthDate         DateTime? @map("birth_date") @db.Date
  city              String?
  previousEducation String?   @map("previous_education")
  guardian          Json? // obligatorio si es menor: {nombre, documento, parentesco, telefono, email}
  consentAt         DateTime  @map("consent_at")
  consentIp         String    @map("consent_ip")
  consentVersion    String    @map("consent_version")
  guardianConsent   Boolean   @default(false) @map("guardian_consent")
  /// Creado con una llave *_test_ de la API pública: no cuenta ni aparece en la bandeja real.
  isTest            Boolean   @default(false) @map("is_test")
  utm               Json? // utm_*, gclid, fbclid, landing, referrer
  studentId         String?   @map("student_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  applications Application[]

  @@unique([tenantId, documentType, documentNumber])
  @@index([tenantId])
  @@index([tenantId, email])
  @@map("applicants")
}

// Solicitud de inscripción a una convocatoria. callId es null únicamente en
// los leads (INTERESADO) que llegan por /contacto o POST /leads sin programa.
model Application {
  id                   String            @id @default(uuid())
  tenantId             String            @map("tenant_id")
  applicantId          String            @map("applicant_id")
  callId               String?           @map("call_id")
  targetLevel          Int?              @map("target_level") // colegio: grado al que aspira
  submittedByGuardian  Boolean           @default(false) @map("submitted_by_guardian")
  code                 String // legible: "INS-2027-000123"
  status               ApplicationStatus @default(BORRADOR)
  paymentMethod        String?           @map("payment_method")
  paymentRef           String?           @map("payment_ref")
  paidAt               DateTime?         @map("paid_at")
  reviewerId           String?           @map("reviewer_id")
  decisionNotes        String?           @db.Text @map("decision_notes")
  isTest               Boolean           @default(false) @map("is_test") // llaves *_test_: fuera de bandeja y cupos
  externalId           String?           @map("external_id") // id del CRM de la institución (API pública)
  accessTokenHash      String?           @map("access_token_hash") // enlace mágico: nunca el token plano
  accessTokenExpiresAt DateTime?         @map("access_token_expires_at")
  submittedAt          DateTime?         @map("submitted_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")

  applicant Applicant             @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  call      AdmissionCall?        @relation(fields: [callId], references: [id], onDelete: Restrict)
  documents ApplicationDocument[]
  events    ApplicationEvent[]

  @@unique([tenantId, code])
  @@unique([applicantId, callId])
  @@index([tenantId, status])
  @@map("applications")
}

model ApplicationDocument {
  id            String  @id @default(uuid())
  tenantId      String  @map("tenant_id")
  applicationId String  @map("application_id")
  requiredDocId String? @map("required_doc_id")
  fileKey       String  @map("file_key") // almacenamiento privado; nunca URL pública
  originalName  String  @map("original_name")
  mimeType      String  @map("mime_type")
  sizeKb        Int     @map("size_kb")
  status        String  @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  reviewNote    String? @map("review_note")

  application Application                @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requiredDoc AdmissionRequiredDocument? @relation(fields: [requiredDocId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@map("application_documents")
}

// Línea de tiempo / auditoría de la solicitud.
model ApplicationEvent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  applicationId String   @map("application_id")
  type          String // submitted, payment_confirmed, doc_rejected, admitted…
  actorUserId   String?  @map("actor_user_id") // null = aspirante o sistema
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("application_events")
}
