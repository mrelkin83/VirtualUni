model Book {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  titulo                String
  autor                 String
  isbn                  String?
  categoria             String
  editorial             String?
  anio                  Int?
  descripcion           String?  @db.Text
  portadaUrl            String?  @map("portada_url")
  ubicacion             String?
  ejemplaresTotal       Int      @default(1) @map("ejemplares_total")
  ejemplaresDisponibles Int      @default(1) @map("ejemplares_disponibles")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  loans        BookLoan[]
  reservations BookReservation[]

  @@index([tenantId])
  @@index([categoria])
  @@map("books")
}

model BookLoan {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  bookId           String     @map("book_id")
  studentId        String     @map("student_id")
  fechaPrestamo    DateTime   @default(now()) @map("fecha_prestamo")
