// Anuncios Institucionales
model Announcement {
  id          String               @id @default(uuid())
  tenantId    String               @map("tenant_id")
  titulo      String
  contenido   String               @db.Text
  autor       String
  prioridad   AnnouncementPriority
  estado      AnnouncementStatus
