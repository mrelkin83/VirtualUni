<%
  const slide = (it.site.heroSlides && it.site.heroSlides[0]) || {};
  const ocultas = new Set(((it.site.sections || {}).hidden) || []);
  const rollingAbierta = it.convocatorias.some((cv) => cv.rolling);
%>

<section class="hero-cartel banda-tinta text-white">
  <span class="vigilada-borde hidden md:block"><%= it.textos.vigilada %></span>
  <div class="relative z-10 mx-auto max-w-6xl px-4 pt-14 pb-24 md:pt-20 md:pb-40 grid items-center gap-10 lg:grid-cols-[1fr_360px]">
    <div>
      <span class="sello anim-subir text-base md:text-lg">
        <%= rollingAbierta ? '¡Inscripción permanente!' : ('¡' + it.textos.inscripciones + ' abiertas!') %>
      </span>
      <h1 class="titulo-cartel anim-subir anim-r1 mt-7 text-5xl md:text-7xl max-w-3xl text-white">
        <%= slide.title || it.tenant.name %>
      </h1>
      <% if (slide.subtitle) { %>
      <p class="anim-subir anim-r2 mt-5 max-w-xl text-white/85 text-lg md:text-xl"><%= slide.subtitle %></p>
      <% } %>
      <div class="anim-subir anim-r3 mt-10 flex flex-wrap items-center gap-5">
        <a href="<%= (slide.ctaPrimary && slide.ctaPrimary.href !== 'whatsapp' && slide.ctaPrimary.href) || '/admisiones' %>"
           class="pleca text-lg md:text-xl font-display shadow-lg hover:brightness-110 transition">
          <span><%= (slide.ctaPrimary && slide.ctaPrimary.label) || ('¡' + it.textos.inscribete + ' hoy!') %> →</span>
        </a>
        <% if (it.site.whatsappNumber) { %>
        <a href="https://wa.me/<%= it.site.whatsappNumber %>?text=<%= encodeURIComponent(it.site.whatsappMessage || '') %>" target="_blank" rel="noopener"
           class="px-6 py-3 rounded-full border-2 border-white/60 font-display font-bold text-white hover:bg-white/10 transition">
          <%= (slide.ctaSecondary && slide.ctaSecondary.label) || 'Habla con un asesor' %>
        </a>
        <% } %>
      </div>
    </div>
    <div class="relative hidden lg:block" aria-hidden="true">
      <% if (slide.imageUrl) { %>
      <div class="marco-blob shadow-2xl rotate-2">
        <img src="<%= slide.imageUrl %>" alt="" fetchpriority="high" width="420" height="420" class="w-full aspect-square object-cover" />
      </div>
      <% } else { %>
      <p class="inicial-fantasma text-right"><%= it.tenant.name.charAt(0) %></p>
      <% } %>
    </div>
  </div>
</section>

<section class="relative z-10 mx-auto max-w-5xl px-4 -mt-12 md:-mt-16" aria-label="Buscar en la oferta">
  <form action="/programas" method="get" class="carta rounded-2xl p-5 md:p-6" style="box-shadow:var(--sombra-carta-alta)">
    <% if (it.site.showHeroSearch) { %>
    <div class="flex rounded-xl overflow-hidden border border-gray-300 focus-within:border-[var(--c1)]">
      <svg class="self-center ml-4 shrink-0 text-gray-400" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.3-3.3"/></svg>
      <input type="search" name="q" placeholder="¿Qué quieres estudiar?" aria-label="Buscar programa"
             class="flex-1 px-3.5 py-3.5 text-gray-900 text-lg outline-none min-w-0" />
      <button class="px-6 font-display font-bold text-white text-lg" style="background:var(--c1)">Buscar</button>
    </div>
    <% } %>
    <div class="<%= it.site.showHeroSearch ? 'mt-4' : '' %> flex flex-wrap items-center gap-2">
      <span class="font-mono text-[11px] uppercase tracking-wider text-gray-500 mr-1">Niveles:</span>
      <a href="/programas" class="px-4 py-2 rounded-full text-sm font-semibold text-white" style="background:var(--c1)">Todos</a>
      <% for (const cat of it.nav.categorias) { %>
      <a href="/programas?nivel=<%= cat.slug %>"
         class="px-4 py-2 rounded-full border border-gray-300 text-sm font-semibold text-gray-700 hover:border-[var(--c1)] hover:text-[var(--c1)] transition">
        <%= cat.label %> <span class="font-mono text-xs text-gray-500">(<%= cat.count %>)</span>
      </a>
      <% } %>
    </div>
  </form>
</section>

<% if (!ocultas.has('featured') && it.porCategoria.length) { %>
<section class="mx-auto max-w-6xl px-4 pt-16">
  <div class="flex items-end justify-between gap-4 flex-wrap">
    <div>
      <p class="kicker" style="color:var(--c1)">Oferta <%= it.anio %></p>
      <h2 class="mt-2 titulo-cartel text-4xl md:text-5xl text-gray-900"><%= it.textos.ofertaTitulo %></h2>
      <p class="text-gray-500 mt-2"><%= it.textos.ofertaSubtitulo %></p>
    </div>
    <a href="/programas" class="font-bold enlace-nav pb-1" style="color:var(--c1)">Ver toda la oferta →</a>
  </div>

  <% for (const cat of it.porCategoria) { if (!cat.programas.length) continue; %>
  <div class="mt-12">
    <div class="flex items-baseline justify-between gap-4 border-b-2 pb-2" style="border-color:var(--borde-tinte)">
      <h3 class="font-cartel uppercase text-2xl text-gray-900"><%= cat.label %></h3>
      <a href="/programas?nivel=<%= cat.slug %>" class="text-sm font-bold shrink-0 py-1" style="color:var(--c1)">
        <%= cat.count > cat.programas.length ? ('Ver los ' + cat.count) : 'Ver todos' %> →
      </a>
    </div>
    <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% for (const p of cat.programas) { %><%~ include('partials/tarjeta', { p }) %><% } %>
    </div>
  </div>
  <% } %>
</section>
<% } %>

<% if (!ocultas.has('calls')) { %>
<section class="mt-20 py-16" style="background:var(--tinte)">
  <div class="mx-auto max-w-6xl px-4">
    <p class="kicker" style="color:var(--c1)"><%= it.textos.inscripciones %></p>
    <h2 class="mt-2 titulo-cartel text-4xl md:text-5xl text-gray-900">Así de simple es ingresar</h2>

    <div class="mt-9 grid gap-6 md:grid-cols-4">
      <% const pasos = [
        ['Explora', 'Encuentra tu programa y revisa requisitos, fechas y costos.'],
        ['Inscríbete en línea', 'Llena el formulario y adjunta tus documentos. Sin filas.'],
        ['Paga y espera la revisión', 'Paga en línea o reporta tu pago; revisamos tus documentos.'],
        ['Matricúlate', 'Si eres admitido, formalizas tu matrícula y entras al campus.'],
      ]; %>
      <% pasos.forEach(([titulo, texto], i) => { %>
      <div class="carta relative rounded-xl p-6 overflow-hidden">
        <span class="numero-cartel absolute right-3 top-0 select-none" aria-hidden="true" style="opacity:.16"><%= i + 1 %></span>
        <span class="numero-cartel block text-2xl" style="font-size:1.6rem"><%= i + 1 %>.</span>
        <h3 class="mt-2 font-display font-extrabold text-gray-900"><%= titulo %></h3>
        <p class="mt-1.5 text-sm text-gray-600 relative"><%= texto %></p>
      </div>
      <% }); %>
    </div>

    <% if (it.convocatorias.length) { %>
    <div class="mt-12 grid gap-3 md:grid-cols-2">
      <% for (const cv of it.convocatorias.slice(0, 6)) { %>
      <a href="/programas/<%= cv.programaSlug %>" class="carta carta-link group flex items-center justify-between gap-4 rounded-xl px-5 py-4">
        <div class="min-w-0">
          <p class="font-bold text-gray-900 truncate group-hover:text-[var(--c1)]"><%= cv.programa %></p>
          <p class="font-mono text-[13px] text-gray-500 mt-0.5">
            <% if (cv.rolling) { %>Inscripción permanente<% } else if (cv.closesAt) { %>Cierra: <%= it.fecha(cv.closesAt) %><% } %>
            <% if (cv.startsAt) { %> · Inicio: <%= it.fecha(cv.startsAt) %><% } %>
          </p>
        </div>
        <span class="shrink-0 text-sm font-bold" style="color:var(--c1)"><%= it.textos.inscribete %> →</span>
      </a>
      <% } %>
    </div>
    <% } %>

    <div class="mt-9">
      <a href="/admisiones" class="inline-block px-7 py-3.5 rounded-lg font-display font-bold text-white shadow-sm hover:opacity-90 transition" style="background:var(--c1)">Conoce el proceso completo</a>
    </div>
  </div>
</section>
<% } %>

<% if (!ocultas.has('benefits') && it.site.benefits && it.site.benefits.length) { %>
<section class="mx-auto max-w-6xl px-4 py-16">
  <p class="kicker justify-center" style="color:var(--c1)">¿Por qué aquí?</p>
  <h2 class="mt-2 titulo-cartel text-4xl text-gray-900 text-center">Razones para elegirnos</h2>
  <div class="mt-10 grid gap-6 md:grid-cols-3">
    <% for (const b of it.site.benefits) { %>
    <div class="carta carta-link rounded-xl p-7">
      <div class="h-11 w-11 rounded-lg grid place-items-center text-white font-black" style="background:var(--c2)">✓</div>
      <h3 class="mt-4 font-display font-bold text-lg text-gray-900"><%= b.title %></h3>
      <p class="mt-1.5 text-[15px] text-gray-600"><%= b.text %></p>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (!ocultas.has('stats') && it.site.stats && it.site.stats.length) { %>
<section class="py-14 text-white banda-tinta">
  <div class="mx-auto max-w-6xl px-4 grid gap-8 text-center" style="grid-template-columns:repeat(<%= it.site.stats.length %>,1fr)">
    <% for (const s of it.site.stats) { %>
    <div>
      <p class="font-cartel text-4xl md:text-6xl" style="color:var(--c2)"><%= s.value %></p>
      <p class="text-white/80 text-sm mt-2 font-semibold"><%= s.label %></p>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (it.nav.paginas.length) { %>
<section class="mx-auto max-w-6xl px-4 py-16">
  <p class="kicker" style="color:var(--c1)">Institución</p>
  <h2 class="mt-2 titulo-cartel text-4xl md:text-5xl text-gray-900">Conócenos</h2>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% const planas = it.nav.paginas.flatMap((g) => g.items.map((pg) => ({ ...pg, grupo: g.grupo }))).slice(0, 6); %>
    <% for (const pg of planas) { %>
    <a href="/institucional/<%= pg.slug %>" class="carta carta-link group rounded-xl p-6">
      <p class="font-mono text-[11px] uppercase tracking-wider text-gray-500"><%= pg.grupo %></p>
      <h3 class="mt-1.5 font-display font-bold text-lg text-gray-900 group-hover:text-[var(--c1)]"><%= pg.title %></h3>
      <p class="mt-3 text-sm font-bold" style="color:var(--c1)">Leer más →</p>
    </a>
    <% } %>
  </div>
</section>
<% } %>

<% if (!ocultas.has('cta')) { %>
<section class="mx-auto max-w-6xl px-4 pb-4">
  <div class="rounded-2xl banda-tinta text-white px-8 py-12 md:px-14 md:py-14 flex flex-wrap items-center justify-between gap-6">
    <div>
      <h2 class="titulo-cartel text-4xl md:text-5xl">Da el primer paso hoy</h2>
      <p class="mt-2 text-white/80 max-w-md">El proceso es 100% en línea y te toma menos de 10 minutos. Tu cupo te está esperando.</p>
    </div>
    <div class="flex gap-3 flex-wrap">
      <a href="/admisiones" class="px-7 py-3.5 rounded-lg bg-white font-display font-bold shadow hover:shadow-lg transition" style="color:var(--tinta)"><%= it.textos.inscribete %></a>
      <% if (!it.modoSoloAdmisiones) { %><a href="/contacto" class="px-7 py-3.5 rounded-lg border-2 border-white/60 font-display font-bold text-white hover:bg-white/10 transition">Pide información</a><% } %>
    </div>
  </div>
</section>
<% } %>
