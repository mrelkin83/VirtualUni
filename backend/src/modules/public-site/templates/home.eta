<% const slide = (it.site.heroSlides && it.site.heroSlides[0]) || {}; %>
<section class="relative overflow-hidden" style="background:linear-gradient(135deg,var(--c1),var(--c2))">
  <% if (slide.imageUrl) { %>
    <img src="<%= slide.imageUrl %>" alt="" fetchpriority="high" width="1600" height="640"
         class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black" style="opacity:<%= Math.min(Math.max(Number(slide.overlay ?? 0.5), 0), 0.85) %>"></div>
  <% } %>
  <div class="relative mx-auto max-w-6xl px-4 py-20 md:py-28 text-white">
    <h1 class="text-3xl md:text-5xl font-black max-w-2xl leading-tight"><%= slide.title || it.tenant.name %></h1>
    <% if (slide.subtitle) { %><p class="mt-4 max-w-xl text-white/90 md:text-lg"><%= slide.subtitle %></p><% } %>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="<%= (slide.ctaPrimary && slide.ctaPrimary.href !== 'whatsapp' && slide.ctaPrimary.href) || '/programas' %>"
         class="px-6 py-3 rounded-lg bg-white font-bold shadow hover:shadow-lg" style="color:var(--c1)">
        <%= (slide.ctaPrimary && slide.ctaPrimary.label) || it.textos.inscribete %>
      </a>
      <% if (it.site.whatsappNumber) { %>
      <a href="https://wa.me/<%= it.site.whatsappNumber %>?text=<%= encodeURIComponent(it.site.whatsappMessage || '') %>" target="_blank" rel="noopener"
         class="px-6 py-3 rounded-lg border-2 border-white/70 font-bold text-white hover:bg-white/10">
        <%= (slide.ctaSecondary && slide.ctaSecondary.label) || 'Habla con un asesor' %>
      </a>
      <% } %>
    </div>
    <% if (it.site.showHeroSearch) { %>
    <form action="/programas" method="get" class="mt-10 max-w-lg flex rounded-xl overflow-hidden shadow-lg bg-white">
      <input type="search" name="q" placeholder="¿Qué quieres estudiar?" aria-label="Buscar programa"
             class="flex-1 px-4 py-3.5 text-gray-800 outline-none" />
      <button class="px-5 font-bold text-white" style="background:var(--c1)">Buscar</button>
    </form>
    <% } %>
  </div>
</section>

<% if (it.destacados.length) { %>
<section class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-2xl md:text-3xl font-black text-gray-900"><%= it.textos.ofertaTitulo %></h2>
  <p class="text-gray-500 mt-1"><%= it.textos.ofertaSubtitulo %></p>
  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% for (const p of it.destacados) { %><%~ include('partials/tarjeta', { p }) %><% } %>
  </div>
  <div class="mt-8 text-center">
    <a href="/programas" class="inline-block px-6 py-3 rounded-lg font-bold text-white" style="background:var(--c1)">Ver toda la oferta</a>
  </div>
</section>
<% } %>

<% if (it.convocatorias.length) { %>
<section class="bg-gray-50 py-14">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-2xl font-black text-gray-900"><%= it.textos.inscripciones %> abiertas</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      <% for (const cv of it.convocatorias.slice(0, 6)) { %>
      <a href="/programas/<%= cv.programaSlug %>" class="flex items-center justify-between gap-4 rounded-xl border border-gray-200 bg-white p-4 hover:border-[var(--c1)] hover:shadow transition">
        <div class="min-w-0">
          <p class="font-bold text-gray-900 truncate"><%= cv.programa %></p>
          <p class="text-sm text-gray-500">
            <% if (cv.rolling) { %>Inscripción permanente<% } else if (cv.closesAt) { %>Cierra el <%= it.fecha(cv.closesAt) %><% } %>
            <% if (cv.startsAt) { %> · Inicia <%= it.fecha(cv.startsAt) %><% } %>
          </p>
        </div>
        <span class="shrink-0 text-sm font-bold" style="color:var(--c1)"><%= it.textos.inscribete %> →</span>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>

<% if (it.site.benefits && it.site.benefits.length) { %>
<section class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-2xl font-black text-gray-900 text-center">¿Por qué estudiar aquí?</h2>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    <% for (const b of it.site.benefits) { %>
    <div class="rounded-xl border border-gray-200 p-6 text-center">
      <div class="mx-auto h-11 w-11 rounded-full grid place-items-center text-white font-black" style="background:var(--c2)">✓</div>
      <h3 class="mt-3 font-bold text-gray-900"><%= b.title %></h3>
      <p class="mt-1 text-sm text-gray-500"><%= b.text %></p>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<% if (it.site.stats && it.site.stats.length) { %>
<section class="py-12 text-white" style="background:var(--c1)">
  <div class="mx-auto max-w-6xl px-4 grid gap-6 text-center" style="grid-template-columns:repeat(<%= it.site.stats.length %>,1fr)">
    <% for (const s of it.site.stats) { %>
    <div><p class="text-3xl md:text-4xl font-black"><%= s.value %></p><p class="text-white/80 text-sm mt-1"><%= s.label %></p></div>
    <% } %>
  </div>
</section>
<% } %>

<section class="mx-auto max-w-3xl px-4 py-16 text-center">
  <h2 class="text-2xl md:text-3xl font-black text-gray-900">Da el primer paso hoy</h2>
  <p class="mt-2 text-gray-500">El proceso de inscripción es 100% en línea y te toma menos de 10 minutos.</p>
  <a href="/programas" class="mt-6 inline-block px-8 py-3.5 rounded-lg font-bold text-white shadow" style="background:var(--c1)"><%= it.textos.inscribete %></a>
</section>
