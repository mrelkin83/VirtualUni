<a href="/programas/<%= it.p.slug %>" class="carta carta-link group flex flex-col rounded-xl overflow-hidden">
  <div class="h-40 bg-gray-100 relative overflow-hidden">
    <% if (it.p.imageUrl) { %>
      <img src="<%= it.p.imageUrl %>" alt="" loading="lazy" width="400" height="160" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" />
    <% } else { %>
      <div class="w-full h-full grid place-items-center banda-tinta">
        <span class="font-display font-black text-5xl text-white/90"><%= it.p.nombre.charAt(0) %></span>
      </div>
    <% } %>
    <div class="absolute top-2.5 left-2.5 flex gap-1.5">
      <% if (it.p.esNuevo) { %><span class="text-[11px] font-bold px-2 py-0.5 rounded bg-amber-400 text-amber-950">NUEVO</span><% } %>
      <% if (it.p.inscripcionesAbiertas) { %><span class="text-[11px] font-bold px-2 py-0.5 rounded bg-emerald-700 text-white">Inscripciones abiertas</span><% } %>
    </div>
  </div>
  <div class="p-5 flex flex-col gap-1.5 flex-1">
    <span class="font-mono text-[11px] font-semibold uppercase tracking-wider" style="color:var(--c1)"><%= it.p.nivelEtiqueta %></span>
    <p class="font-display font-bold text-gray-900 leading-snug group-hover:text-[var(--c1)]"><%= it.p.nombre %></p>
    <p class="text-sm text-gray-500 line-clamp-2 flex-1"><%= it.p.descripcionCorta %></p>
    <div class="pt-2.5 mt-1 border-t border-gray-100 flex items-center justify-between gap-2">
      <p class="font-mono text-xs text-gray-500"><%= it.p.duracion %><% if (it.p.duracion && it.p.modalidad) { %> · <% } %><%= it.p.modalidad %></p>
      <% if (it.p.tuitionDisplay) { %><p class="font-mono text-xs font-semibold text-gray-700 shrink-0"><%= it.p.tuitionDisplay %></p><% } %>
    </div>
  </div>
</a>
