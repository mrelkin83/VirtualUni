<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= it.meta.title %></title>
  <meta name="description" content="<%= it.meta.description %>" />
  <link rel="canonical" href="<%= it.meta.canonical %>" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= it.meta.title %>" />
  <meta property="og:description" content="<%= it.meta.description %>" />
  <meta property="og:url" content="<%= it.meta.canonical %>" />
  <% if (it.meta.image) { %><meta property="og:image" content="<%= it.meta.image %>" /><% } %>
  <% if (it.meta.noindex) { %><meta name="robots" content="noindex,nofollow" /><% } %>
  <link rel="stylesheet" href="/public-assets/site.css" />
  <style>:root{--c1:<%= it.brand.c1 %>;--c2:<%= it.brand.c2 %>}</style>
  <% if (it.meta.jsonld) { %><script type="application/ld+json"><%~ it.meta.jsonld %></script><% } %>
  <% if (it.analytics && it.analytics.ga4) { %>
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= it.analytics.ga4 %>"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','<%= it.analytics.ga4 %>');</script>
  <% } %>
  <% if (it.analytics && it.analytics.gtm) { %>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s);j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= it.analytics.gtm %>');</script>
  <% } %>
  <% if (it.analytics && it.analytics.metaPixel) { %>
  <script>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/es_LA/fbevents.js');fbq('init','<%= it.analytics.metaPixel %>');fbq('track','PageView');</script>
  <% } %>
</head>
<body class="min-h-screen bg-white text-gray-800 flex flex-col">
  <% if (it.esPreview) { %>
  <div class="bg-amber-400 text-amber-950 text-center text-sm font-semibold py-1.5">
    Vista previa — el sitio aún no está publicado
  </div>
  <% } %>

  <header class="border-b border-gray-100 bg-white sticky top-0 z-40">
    <div class="mx-auto max-w-6xl px-4 h-16 flex items-center justify-between gap-4">
      <a href="<%= it.modoSoloAdmisiones && it.site.externalWebsiteUrl ? it.site.externalWebsiteUrl : '/' %>" class="flex items-center gap-3 min-w-0">
        <% if (it.tenant.logo) { %>
          <img src="<%= it.tenant.logo %>" alt="" class="h-9 w-9 rounded object-contain" width="36" height="36" />
        <% } else { %>
          <span class="h-9 w-9 rounded grid place-items-center text-white font-bold" style="background:var(--c1)"><%= it.tenant.name.charAt(0) %></span>
        <% } %>
        <span class="font-bold text-gray-900 truncate"><%= it.tenant.name %></span>
      </a>
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <% if (!it.modoSoloAdmisiones) { %><a href="/" class="hover:text-[var(--c1)]">Inicio</a><% } %>
        <a href="/programas" class="hover:text-[var(--c1)]"><%= it.textos.ofertaTitulo %></a>
        <% if (!it.modoSoloAdmisiones) { %><a href="/contacto" class="hover:text-[var(--c1)]">Contacto</a><% } %>
        <a href="/aspirante" class="hover:text-[var(--c1)]">Consulta tu solicitud</a>
      </nav>
      <div class="flex items-center gap-2">
        <% if (it.modoSoloAdmisiones && it.site.externalWebsiteUrl) { %>
          <a href="<%= it.site.externalWebsiteUrl %>" class="text-sm font-medium text-gray-600 hover:text-[var(--c1)] hidden sm:block">Volver al sitio</a>
        <% } %>
        <a href="/login" class="text-sm font-semibold px-4 py-2 rounded-lg border border-gray-200 hover:border-[var(--c1)] hover:text-[var(--c1)]">Campus virtual</a>
        <button data-menu class="md:hidden p-2 -mr-2" aria-label="Abrir menú">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </div>
    </div>
    <nav data-menu-panel class="md:hidden hidden border-t border-gray-100 px-4 py-3 space-y-2 text-sm font-medium bg-white">
      <% if (!it.modoSoloAdmisiones) { %><a href="/" class="block py-1.5">Inicio</a><% } %>
      <a href="/programas" class="block py-1.5"><%= it.textos.ofertaTitulo %></a>
      <% if (!it.modoSoloAdmisiones) { %><a href="/contacto" class="block py-1.5">Contacto</a><% } %>
      <a href="/aspirante" class="block py-1.5">Consulta tu solicitud</a>
    </nav>
  </header>

  <main class="flex-1"><%~ it.body %></main>

  <footer class="bg-gray-900 text-gray-300 mt-16">
    <div class="mx-auto max-w-6xl px-4 py-10 grid gap-8 md:grid-cols-3 text-sm">
      <div>
        <p class="font-bold text-white mb-2"><%= it.tenant.name %></p>
        <% const c = it.site.contact || {}; %>
        <% if (c.direccion) { %><p><%= c.direccion %></p><% } %>
        <% if (c.telefono) { %><p>Tel: <%= c.telefono %></p><% } %>
        <% if (c.email) { %><p><%= c.email %></p><% } %>
        <% if (c.horario) { %><p class="text-gray-400 mt-1"><%= c.horario %></p><% } %>
      </div>
      <div>
        <p class="font-bold text-white mb-2"><%= it.textos.inscripciones %></p>
        <p><a href="/programas" class="hover:text-white"><%= it.textos.ofertaTitulo %></a></p>
        <p><a href="/aspirante" class="hover:text-white">Estado de tu solicitud</a></p>
        <% if (!it.modoSoloAdmisiones) { %><p><a href="/contacto" class="hover:text-white">Contacto</a></p><% } %>
      </div>
      <div>
        <p class="font-bold text-white mb-2">Legal</p>
        <p><a href="/privacidad" class="hover:text-white">Tratamiento de datos personales</a></p>
        <% if (it.site.dataControllerName) { %><p class="text-gray-400 mt-1">Responsable: <%= it.site.dataControllerName %></p><% } %>
      </div>
    </div>
    <div class="border-t border-gray-800 py-4 text-center text-xs text-gray-500">
      © <%= it.anio %> <%= it.tenant.name %>
    </div>
  </footer>

  <% if (it.site.whatsappNumber) { %>
  <a href="https://wa.me/<%= it.site.whatsappNumber %>?text=<%= encodeURIComponent(it.site.whatsappMessage || 'Hola, quiero más información.') %>"
     target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
     class="fixed bottom-5 right-5 z-50 h-14 w-14 rounded-full bg-[#25D366] shadow-lg grid place-items-center hover:scale-105 transition">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.1 8.1 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.6-6.1c-.3-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.6.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.3 0-.4.1-.5l.4-.5a1.7 1.7 0 0 0 .3-.4.5.5 0 0 0 0-.4c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.1 5 5 0 0 0 1.1 2.7 11.4 11.4 0 0 0 4.4 3.8 14.5 14.5 0 0 0 1.5.5 3.5 3.5 0 0 0 1.6.1 2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .2-1.2c-.1-.1-.3-.2-.6-.3Z"/></svg>
  </a>
  <% } %>

  <script src="/public-assets/site.js" defer></script>
</body>
</html>
