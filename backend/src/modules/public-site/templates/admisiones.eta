<section class="hero-cartel banda-tinta text-white">
  <span class="vigilada-borde hidden md:block"><%= it.textos.vigilada %></span>
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-14 md:py-20">
    <span class="sello text-sm">Proceso <%= it.anio %> · 100% en línea</span>
    <h1 class="mt-6 titulo-cartel text-5xl md:text-6xl"><%= it.textos.inscripciones %></h1>
    <p class="mt-4 max-w-2xl text-white/85 text-lg">
      Todo el proceso es en línea: te inscribes, adjuntas tus documentos, pagas y consultas el estado
      de tu solicitud sin ir a ninguna oficina.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/programas" class="px-6 py-3 rounded-lg bg-white font-display font-bold shadow" style="color:var(--tinta)">Explora la oferta</a>
      <a href="/aspirante" class="px-6 py-3 rounded-lg border-2 border-white/60 font-display font-bold text-white hover:bg-white/10 transition">Ya me inscribí: ver mi estado</a>
    </div>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="titulo-cartel text-4xl md:text-5xl text-gray-900">El proceso, paso a paso</h2>
  <div class="mt-9 grid gap-x-8 gap-y-10 md:grid-cols-2">
    <% const pasos = [
      ['Elige tu programa', 'Revisa la oferta por nivel, compara duración, modalidad y costos, y mira los requisitos y documentos que pide cada convocatoria.'],
      ['Llena el formulario', 'Diligencia tus datos y adjunta los documentos en PDF o imagen. Si el aspirante es menor de edad, primero van los datos del acudiente.'],
      ['Paga la inscripción', 'Si la convocatoria tiene costo, puedes pagar en línea o hacer el pago por los medios informados y subir tu comprobante.'],
      ['Revisión de documentos', 'El equipo de admisiones revisa lo que enviaste. Si algo falta o quedó ilegible, te lo pedimos de nuevo por correo.'],
      ['Decisión de admisión', 'Con documentos y pago al día, la institución decide tu admisión y te la notifica por correo.'],
      ['Matrícula', 'Si eres admitido, formalizas tu matrícula, recibes tus credenciales y entras al campus virtual.'],
    ]; %>
    <% pasos.forEach(([titulo, texto], i) => { %>
    <div class="flex gap-5">
      <span class="numero-cartel shrink-0 w-14 text-right" aria-hidden="true"><%= i + 1 %></span>
      <div>
        <h3 class="font-display font-bold text-lg text-gray-900"><%= titulo %></h3>
        <p class="mt-1 text-gray-600"><%= texto %></p>
      </div>
    </div>
    <% }); %>
  </div>
</section>

<% if (it.convocatorias.length) { %>
<section class="py-14" style="background:var(--tinte)">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="titulo-cartel text-4xl text-gray-900">Convocatorias abiertas</h2>
    <p class="text-gray-600 mt-2">Estas son las fechas vigentes. Haz clic para ver requisitos e inscribirte.</p>
    <div class="mt-8 grid gap-3">
      <% for (const cv of it.convocatorias) { %>
      <a href="/programas/<%= cv.programaSlug %>" class="carta carta-link group flex flex-wrap items-center justify-between gap-3 rounded-xl px-5 py-4">
        <div class="min-w-0">
          <p class="font-display font-bold text-gray-900 group-hover:text-[var(--c1)]"><%= cv.programa %></p>
          <p class="text-sm text-gray-500"><%= cv.name %></p>
        </div>
        <div class="flex items-center gap-6 shrink-0">
          <p class="font-mono text-[13px] text-gray-600">
            <% if (cv.rolling) { %>Inscripción permanente<% } else if (cv.closesAt) { %>Cierra: <%= it.fecha(cv.closesAt) %><% } %>
            <% if (cv.startsAt) { %> · Inicio: <%= it.fecha(cv.startsAt) %><% } %>
          </p>
          <span class="text-sm font-bold" style="color:var(--c1)"><%= it.textos.inscribete %> →</span>
        </div>
      </a>
      <% } %>
    </div>
  </div>
</section>
<% } else { %>
<section class="py-14" style="background:var(--tinte)">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="titulo-cartel text-4xl text-gray-900">Convocatorias</h2>
    <p class="text-gray-600 mt-2">
      En este momento no hay convocatorias abiertas. Déjanos tus datos en
      <a href="/contacto" class="enlace">contacto</a> y te avisamos cuando abran.
    </p>
  </div>
</section>
<% } %>

<section class="mx-auto max-w-6xl px-4 py-14 grid gap-10 md:grid-cols-2">
  <div>
    <h2 class="titulo-cartel text-3xl text-gray-900">Pagos</h2>
    <p class="mt-3 text-gray-600">
      Cuando tu convocatoria tiene costo de inscripción, puedes pagar en línea con tarjeta, PSE o
      los medios disponibles, o hacer el pago directo y subir tu comprobante desde el formulario.
    </p>
    <% if (it.site.paymentInstructions) { %>
    <div class="mt-5 rounded-xl border border-gray-200 p-5 bg-gray-50">
      <p class="font-mono text-[11px] uppercase tracking-wider text-gray-500 mb-2">Medios de pago informados</p>
      <p class="text-sm text-gray-700 whitespace-pre-line"><%= it.site.paymentInstructions %></p>
    </div>
    <% } %>
  </div>
  <div>
    <h2 class="titulo-cartel text-3xl text-gray-900">¿Ya te inscribiste?</h2>
    <p class="mt-3 text-gray-600">
      Consulta el estado de tu solicitud con tu documento y el correo con el que te registraste.
      Te enviamos un enlace de acceso de un solo uso: sin usuarios ni claves.
    </p>
    <a href="/aspirante" class="mt-5 inline-block px-6 py-3 rounded-lg font-display font-bold text-white shadow-sm hover:opacity-90 transition" style="background:var(--c1)">Consultar mi solicitud</a>
  </div>
</section>
