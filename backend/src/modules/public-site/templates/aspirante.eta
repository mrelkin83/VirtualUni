<section class="mx-auto max-w-3xl px-4 py-10">
  <h1 class="text-2xl md:text-3xl font-black text-gray-900">Consulta tu solicitud</h1>

  <% if (it.vencido) { %>
  <p class="mt-4 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 text-sm px-4 py-3">
    Ese enlace ya se usó o venció. Pide uno nuevo aquí abajo.
  </p>
  <% } %>

  <% if (!it.autenticado) { %>
  <div class="mt-6 rounded-xl border border-gray-200 p-5 max-w-md">
    <p class="text-sm text-gray-600">
      Escribe el documento del aspirante y el correo con el que se inscribió; te enviaremos un
      <strong>enlace de acceso</strong> de un solo uso.
    </p>
    <form data-form-enlace class="mt-4 space-y-3">
      <%~ it.antispam %>
      <input name="documentNumber" placeholder="Número de documento" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" />
      <input name="email" type="email" placeholder="Correo electrónico" class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-sm" />
      <button class="w-full rounded-lg px-4 py-3 font-bold text-white text-sm" style="background:var(--c1)">Enviarme el enlace</button>
      <p data-msg-enlace class="hidden text-sm text-emerald-700 bg-emerald-50 border border-emerald-200 rounded-lg px-3 py-2"></p>
    </form>
  </div>
  <% } else { %>
  <div data-solicitudes data-autenticado="1" class="mt-6 space-y-4">
    <p class="text-sm text-gray-500">Cargando tus solicitudes…</p>
  </div>
  <% } %>
</section>
<script src="/public-assets/inscripcion.js" defer></script>
